<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Sandbox: the game starts its crew's mind (a local Python service), talks to it over localhost and
	     reads its data in Application Support; the sandboxes UE uses by default would forbid all three. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
